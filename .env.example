# --- PostgreSQL ---
POSTGRES_DB=infobizbot
POSTGRES_USER=infobizbot
POSTGRES_PASSWORD=change_me_pg

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://infobizbot:change_me_pg@db:5432/infobizbot
JWT_SECRET=change_me_to_long_random_string
JWT_TTL_MIN=10080
DEFAULT_CURRENCY=RUB
CORS_ORIGINS=https://localhost,https://72.56.72.136
PUBLIC_BASE_URL=https://72.56.72.136

# Initial admin (создаётся при первой миграции, если админов нет)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# --- Admin panel ---
# Same-origin: оставляем пустым, обращения идут через nginx по /api
NEXT_PUBLIC_API_BASE=/api
# Используется для absolute URL в OpenGraph/Twitter мета-тегах и manifest
NEXT_PUBLIC_SITE_URL=https://72.56.72.136

# --- Логи / observability ---
LOG_LEVEL=INFO
ENV=production
# SENTRY_DSN=https://abc@o0.ingest.sentry.io/0   # пусто → Sentry выключен
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
COOKIE_SECURE=true
